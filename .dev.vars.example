# MUST be the Atlas mongodb+srv URL — private-IP URLs won't work from CF edge,
# but for `wrangler pages dev` running on your laptop, a private-IP URL works
# *if* your machine is on the same network as the DB.
DB_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=chaudhar007DB
